# --- Server ---
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN=http://localhost:5500

# --- Database ---
# PostgreSQL connection string. After setting this, run:
#   npm run db:migrate
DATABASE_URL=postgres://user:password@localhost:5432/northstar

# --- Auth ---
# Generate a strong random value for production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Seeds the single admin account on first run. Change the password
# before deploying — this is only a safe default for local development.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# --- File storage ---
# Leave blank to use local disk storage under backend/uploads (fine for
# local dev/testing). Set both to use Supabase Storage in production.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=northstar

# --- Logging ---
LOG_LEVEL=debug
